	"item": [
		{
			"name": "1. Создать шаблон - Зарплата Цех",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text"
					},
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Шаблон зарплаты цеха - Стандартный\",\n  \"templateType\": \"workers\",\n  \"workersData\": [\n    {\n      \"name\": \"Иванов Иван Иванович\",\n      \"numberOfHoursWorked\": 8,\n      \"salaryPerDay\": 2000,\n      \"salaryPerHour\": 250,\n      \"total\": 16000\n    },\n    {\n      \"name\": \"Петров Петр Петрович\",\n      \"numberOfHoursWorked\": 8,\n      \"salaryPerDay\": 1800,\n      \"salaryPerHour\": 225,\n      \"total\": 14400\n    }\n  ]\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/template",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"template"
					]
				},
				"description": "Создает новый шаблон для таблицы \"Зарплата - Цех\""
			},
			"response": []
		},
